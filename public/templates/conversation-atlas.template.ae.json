  {
   "id": "tpl:conversation-atlas:script-top-topics",
   "kind": "entity",
   "type": "script",
   "label": "Top topics",
   "description": "The thirty topics with the most segments, as a horizontal bar — the vocabulary of the corpus at a glance.",
   "tags": [
    "atlas",
    "script",
    "subject"
   ],
   "data": {
    "code": "// Top topics: the thirty with the most segments.\nconst topics = topK(ds.byType('topic'), (t) => t.data.segment_count ?? 0, 30).reverse()\nreturn figure(bar(topics.map((t) => t.data.segment_count ?? 0), topics.map((t) => t.label ?? t.id), { orientation: 'h', marker: { color: plotColor(0) }, text: topics.map((t) => t.data.segment_count ?? 0), textposition: 'outside' }), { title: 'Top topics', xaxis: { title: 'segments' }, margin: { l: 220 }, height: 720 })\n",
    "language": "js",
    "lastRun": {
     "at": "2026-09-15T00:00:00.000Z",
     "summary": "figure",
     "ms": 0
    }
   },
   "meta": {
    "createdAt": "2026-09-15T00:00:00.000Z",
    "updatedAt": "2026-09-15T00:00:00.000Z",
    "source": "template:conversation-atlas"
   }
  },
  {
   "id": "tpl:conversation-atlas:script-domain-x-theme",
   "kind": "entity",
   "type": "script",
   "label": "Domain × theme",
   "description": "How often each domain (the subject area) meets each theme (the current underneath): a heat grid over the segments’ facets. The bright cells are what this corpus is really about.",
   "tags": [
    "atlas",
    "script",
    "subject"
   ],
   "data": {
    "code": "// Domain × theme: co-occurrence over the segments' facets.\nconst cells = new Map()\nconst dom = new Map(), thm = new Map()\nfor (const s of ds.byType('segment')) {\n  const f = s.data.facets ?? {}\n  for (const d of f.domain ?? []) {\n    dom.set(d, (dom.get(d) ?? 0) + 1)\n    for (const t of f.theme ?? []) {\n      thm.set(t, (thm.get(t) ?? 0) + 1)\n      const k = d + '\\u0000' + t\n      cells.set(k, (cells.get(k) ?? 0) + 1)\n    }\n  }\n}\nconst domains = sortBy([...dom.keys()], (d) => dom.get(d), true).slice(0, 25)\nconst themes = sortBy([...thm.keys()], (t) => thm.get(t), true)\nconst z = themes.map((t) => domains.map((d) => cells.get(d + '\\u0000' + t) ?? 0))\nreturn figure(heatmap(domains, themes, z, { colorscale: 'Viridis', hovertemplate: '%{x} × %{y}: %{z}<extra></extra>' }), { title: 'Domain × theme', margin: { l: 180, b: 140 }, xaxis: { tickangle: -45 }, height: 640 })\n",
    "language": "js",
    "lastRun": {
     "at": "2026-09-15T00:00:00.000Z",
     "summary": "figure",
     "ms": 0
    }
   },
   "meta": {
    "createdAt": "2026-09-15T00:00:00.000Z",
    "updatedAt": "2026-09-15T00:00:00.000Z",
    "source": "template:conversation-atlas"
   }
  },
  {
   "id": "tpl:conversation-atlas:script-topic-emergence",
   "kind": "entity",
   "type": "script",
   "label": "Topic emergence",
   "description": "When each topic first appeared, and how many distinct topics the corpus had touched by each month — the growth of what you talk about.",
   "tags": [
    "atlas",
    "script",
    "subject"
   ],
   "data": {
    "code": "// Topic emergence: the month a topic is first seen, and the running number of distinct topics.\nconst first = new Map()\nfor (const s of ds.byType('segment')) {\n  const m = bin(s.data.created, 'month')\n  if (!m) continue\n  for (const r of ds.out(s.id, 'on-topic')) if (!first.has(r.target) || m < first.get(r.target)) first.set(r.target, m)\n}\nconst perMonth = groupBy([...first.values()], (m) => m)\nconst months = sortBy([...perMonth.keys()], (m) => m)\nlet running = 0\nconst cum = months.map((m) => (running += perMonth.get(m).length))\nreturn figure([bar(months, months.map((m) => perMonth.get(m).length), { name: 'new topics', marker: { color: plotColor(1) } }), line(months, cum, { name: 'topics so far', yaxis: 'y2', line: { color: plotColor(0), width: 2 } })], { title: 'Topic emergence', yaxis: { title: 'new topics in the month' }, yaxis2: { title: 'distinct topics so far', overlaying: 'y', side: 'right' }, legend: { orientation: 'h', y: 1.08 } })\n",
    "language": "js",
    "lastRun": {
     "at": "2026-09-15T00:00:00.000Z",
     "summary": "figure",
     "ms": 0
    }
   },
   "meta": {
    "createdAt": "2026-09-15T00:00:00.000Z",
    "updatedAt": "2026-09-15T00:00:00.000Z",
    "source": "template:conversation-atlas"
   }
  },
  {
   "id": "tpl:conversation-atlas:script-length-trend",
   "kind": "entity",
   "type": "script",
   "label": "Conversation length trend",
   "description": "The median length of a segment per month, with a three-month rolling median — are the exchanges getting longer or shorter?",
   "tags": [
    "atlas",
    "script",
    "shape"
   ],
   "data": {
    "code": "// Median segment length per month, and a 3-month rolling median.\nconst m = rollup(ds.byType('segment'), (s) => bin(s.data.created, 'month'), (s) => s.data.chars, 'median').filter((r) => r.key)\nconst xs = m.map((r) => r.key), ys = m.map((r) => r.value)\nconst roll = ys.map((_, i) => median(ys.slice(Math.max(0, i - 2), i + 1)))\nreturn figure([bar(xs, ys, { name: 'median chars', marker: { color: plotColor(0) }, opacity: 0.5 }), line(xs, roll, { name: '3-month rolling', line: { color: plotColor(2), width: 3 } })], { title: 'Segment length trend', yaxis: { title: 'characters' } })\n",
    "language": "js",
    "lastRun": {
     "at": "2026-09-15T00:00:00.000Z",
     "summary": "figure",
     "ms": 0
    }
   },
   "meta": {
    "createdAt": "2026-09-15T00:00:00.000Z",
    "updatedAt": "2026-09-15T00:00:00.000Z",
    "source": "template:conversation-atlas"
   }
  },
  {
   "id": "tpl:conversation-atlas:script-hubs",
   "kind": "entity",
   "type": "script",
   "label": "Hubs",
   "description": "The most connected named entities, topics, personas and themes — by how many conversations and segments point at them — as a table.",
   "tags": [
    "atlas",
    "script",
    "subject"
   ],
   "data": {
    "code": "// Hubs: the most connected things the conversations point at.\nconst rows = []\nfor (const type of ['named-entity', 'topic', 'persona', 'theme', 'domain']) {\n  for (const h of topK(ds.byType(type), (e) => ds.degree(e.id), 8)) rows.push({ type, label: h.label ?? h.id, links: ds.degree(h.id), segments: h.data.segment_count ?? '' })\n}\nreturn table(sortBy(rows, (r) => r.links, true), ['type', 'label', 'links', 'segments'])\n",
    "language": "js",
    "lastRun": {
     "at": "2026-09-15T00:00:00.000Z",
     "summary": "figure",
     "ms": 0
    }
   },
   "meta": {
    "createdAt": "2026-09-15T00:00:00.000Z",
    "updatedAt": "2026-09-15T00:00:00.000Z",
    "source": "template:conversation-atlas"
   }
  },
  {
   "id": "tpl:conversation-atlas:script-intent-mix",
   "kind": "entity",
   "type": "script",
   "label": "Intent mix over time",
   "description": "What you wanted from the exchanges — the intent facet — as shares per quarter, stacked to 100%.",
   "tags": [
    "atlas",
    "script",
    "facets"
   ],
   "data": {
    "code": "// Intent mix: the share of each intent per quarter.\nconst by = new Map()\nfor (const s of ds.byType('segment')) {\n  const q = bin(s.data.created, 'quarter')\n  if (!q) continue\n  for (const i of (s.data.facets ?? {}).intent ?? []) {\n    if (!by.has(i)) by.set(i, new Map())\n    by.get(i).set(q, (by.get(i).get(q) ?? 0) + 1)\n  }\n}\nconst quarters = sortBy([...new Set([...by.values()].flatMap((m) => [...m.keys()]))], (q) => q)\nconst totals = quarters.map((q) => [...by.values()].reduce((n, m) => n + (m.get(q) ?? 0), 0))\nconst intents = sortBy([...by.keys()], (i) => [...by.get(i).values()].reduce((a, b) => a + b, 0), true)\nconst traces = intents.map((i, k) => area(quarters, quarters.map((q, j) => (totals[j] ? (by.get(i).get(q) ?? 0) / totals[j] : 0)), { name: i, stackgroup: 'one', line: { color: plotColor(k), width: 0.5 } }))\nreturn figure(traces, { title: 'Intent mix over time', yaxis: { title: 'share', tickformat: '.0%' } })\n",
    "language": "js",
    "lastRun": {
     "at": "2026-09-15T00:00:00.000Z",
     "summary": "figure",
     "ms": 0
    }
   },
   "meta": {
    "createdAt": "2026-09-15T00:00:00.000Z",
    "updatedAt": "2026-09-15T00:00:00.000Z",
    "source": "template:conversation-atlas"
   }
  },
  {
   "id": "tpl:conversation-atlas:script-region-timelines",
   "kind": "entity",
   "type": "script",
   "label": "Region timelines",
   "description": "Each region as a line of segments per month — which subjects rose, which faded.",
   "tags": [
    "atlas",
    "script",
    "subject"
   ],
   "data": {
    "code": "// Region timelines: segments per month, one line per region.\nconst by = groupBy(ds.byType('segment').filter((s) => s.data.region), (s) => s.data.region)\nconst regions = sortBy([...by.keys()], (r) => by.get(r).length, true).slice(0, 12)\nconst traces = regions.map((r, k) => {\n  const m = rollup(by.get(r), (s) => bin(s.data.created, 'month'), () => 1, 'count').filter((x) => x.key)\n  return line(m.map((x) => x.key), m.map((x) => x.value), { name: r, line: { color: plotColor(k), width: 2 } })\n})\nreturn figure(traces, { title: 'Region timelines', yaxis: { title: 'segments' } })\n",
    "language": "js",
    "lastRun": {
     "at": "2026-09-15T00:00:00.000Z",
     "summary": "figure",
     "ms": 0
    }
   },
   "meta": {
    "createdAt": "2026-09-15T00:00:00.000Z",
    "updatedAt": "2026-09-15T00:00:00.000Z",
    "source": "template:conversation-atlas"
   }
  },
  {
   "id": "tpl:conversation-atlas:script-starred-and-salient",
   "kind": "entity",
   "type": "script",
   "label": "Starred and salient",
   "description": "The segments that stood out: starred ones, and the most salient, with when and what — a table to read from.",
   "tags": [
    "atlas",
    "script",
    "shape"
   ],
   "data": {
    "code": "// The segments that stood out.\nconst segs = ds.byType('segment')\nconst pick = sortBy(segs.filter((s) => s.data.starred || (s.data.salience ?? 0) >= 4), (s) => (s.data.starred ? 10 : 0) + (s.data.salience ?? 0), true).slice(0, 60)\nreturn table(pick.map((s) => ({ when: isoDate(s.data.created), conversation: s.data.conversation_title, region: s.data.region, salience: s.data.salience, starred: s.data.starred ? '★' : '', summary: (s.data.summary ?? '').slice(0, 160) })), ['when', 'conversation', 'region', 'salience', 'starred', 'summary'])\n",
    "language": "js",
    "lastRun": {
     "at": "2026-09-15T00:00:00.000Z",
     "summary": "figure",
     "ms": 0
    }
   },

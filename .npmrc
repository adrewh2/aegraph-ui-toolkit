# `@radix-ui/react-tabs`, which reaches the tree through @excalidraw/excalidraw,
# declares a peer of React 16–18 while this app is on React 19. React 19 is
# compatible with what that component uses, and Excalidraw ships it knowingly,
# but npm's resolver refuses the tree without being told — so a plain
# `npm install` fails for a contributor and in CI unless this is set here rather
# than remembered as a flag.
#
# Remove it when Excalidraw's dependency widens its peer range.
legacy-peer-deps=true

# onnxruntime-node (Node-only; @huggingface/transformers depends on it, the
# browser build never loads it) has a postinstall that, on Linux x64, downloads
# CUDA binaries from github.com and unpacks them with no hash check. Nothing
# here uses CUDA, so the download is refused; npm passes this to the script as
# npm_config_onnxruntime_node_install_cuda.
onnxruntime-node-install-cuda=skip

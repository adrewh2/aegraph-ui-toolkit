{
  "name": "aegraph-ui-toolkit",
  "version": "0.0.0",
  "private": true,
  "description": "A workspace for graphs, ontologies and the data around them: Unigraph, the explorer built for a million nodes, with documents, maps, charts, scripts and an assistant that drives all of it by tool.",
  "license": "Apache-2.0",
  "author": "Andrew Han",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "node scripts/hooks.mjs",
    "hooks": "node scripts/hooks.mjs",
    "predev": "node scripts/pyodide/fetch.mjs --quiet && node scripts/vendor.mjs --quiet && node scripts/demos/fetch.mjs --quiet",
    "dev": "vite",
    "prebuild": "node scripts/pyodide/fetch.mjs --quiet && node scripts/vendor.mjs --quiet && node scripts/demos/fetch.mjs --quiet",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "themes": "node scripts/themes/generate.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'mcp/**'",
    "test:bridge": "vitest run mcp/ --no-file-parallelism",
    "test:ci": "npm run test:unit && npm run test:bridge",
    "preview": "vite preview",
    "serve": "npm run build && vite preview --port 5200 --strictPort",
    "demos": "node scripts/demos/fetch.mjs",
    "mcp": "node mcp/server.mjs",
    "build:headless": "vite build --config vite.headless.config.ts",
    "headless": "vite build --config vite.headless.config.ts --logLevel warn && node dist-headless/aegraph-headless.mjs",
    "smoke:headless": "node mcp/smoke-headless.mjs",
    "smoke": "node mcp/smoke.mjs",
    "smoke:scripts": "GL=1 node mcp/drive.mjs mcp/smoke/5-scripts.mjs",
    "smoke:scenes": "GL=1 node mcp/drive.mjs mcp/smoke/6-scenes.mjs",
    "smoke:iterate": "GL=1 node mcp/drive.mjs mcp/smoke/7-iterate.mjs",
    "smoke:claims": "GL=1 node mcp/drive.mjs mcp/smoke/8-claims.mjs",
    "smoke:diagram": "GL=1 node mcp/drive.mjs mcp/smoke/9-diagram.mjs",
    "smoke:projects": "GL=1 node mcp/drive.mjs mcp/smoke/10-projects.mjs",
    "smoke:charts": "GL=1 node mcp/drive.mjs mcp/smoke/11-charts.mjs",
    "smoke:maps": "GL=1 node mcp/drive.mjs mcp/smoke/12-maps.mjs",
    "smoke:media": "GL=1 node mcp/drive.mjs mcp/smoke/13-media.mjs",
    "smoke:way-in": "GL=1 node mcp/drive.mjs mcp/smoke/14-way-in.mjs",
    "smoke:unigraph": "GL=1 node mcp/drive.mjs mcp/smoke/15-unigraph.mjs",
    "smoke:workstation": "GL=1 node mcp/drive.mjs mcp/smoke/16-workstation.mjs",
    "smoke:assistant": "GL=1 node mcp/drive.mjs mcp/smoke/17-assistant-no-key.mjs",
    "smoke:insights": "GL=1 node mcp/drive.mjs mcp/smoke/18-insights.mjs",
    "smoke:entities": "GL=1 node mcp/drive.mjs mcp/smoke/19-entities.mjs",
    "smoke:documents": "GL=1 node mcp/drive.mjs mcp/smoke/20-documents.mjs",
    "smoke:charts-page": "GL=1 node mcp/drive.mjs mcp/smoke/21-charts.mjs",
    "smoke:diagrams-page": "GL=1 node mcp/drive.mjs mcp/smoke/22-diagrams.mjs",
    "smoke:quiet": "GL=1 node mcp/drive.mjs mcp/smoke/23-quiet-mount.mjs",
    "smoke:scene-kept": "GL=1 node mcp/drive.mjs mcp/smoke/24-scene-kept.mjs",
    "smoke:maps-page": "GL=1 node mcp/drive.mjs mcp/smoke/25-maps-page.mjs",
    "smoke:unrun-tools": "GL=1 node mcp/drive.mjs mcp/smoke/26-unrun-tools.mjs",
    "smoke:aurora": "PROFILE=$(mktemp -d) GL=1 node mcp/drive.mjs mcp/smoke/27-aurora-analytics.mjs",
    "smoke:scene-first-slice": "PROFILE=$(mktemp -d) GL=1 node mcp/drive.mjs mcp/smoke/28-scene-first-slice.mjs",
    "pyodide": "node scripts/pyodide/fetch.mjs",
    "vendor": "node scripts/vendor.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.14",
    "@dagrejs/dagre": "^3.1.1",
    "@excalidraw/excalidraw": "^0.18.1",
    "@huggingface/transformers": "^3.8.1",
    "@jitl/quickjs-singlefile-browser-release-sync": "^0.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@viz-js/viz": "^3.31.0",
    "codemirror": "^6.0.2",
    "d3": "^7.9.0",
    "d3-force-3d": "^3.0.6",
    "elkjs": "^0.12.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-gexf": "^0.13.2",
    "graphology-graphml": "^0.5.2",
    "graphology-layout": "^0.6.1",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-layout-noverlap": "^0.4.2",
    "graphology-metrics": "^2.4.2",
    "graphology-shortest-path": "^2.1.0",
    "graphology-types": "^0.24.8",
    "hyparquet": "^1.31.4",
    "hyparquet-compressors": "^1.1.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.57.0",
    "mermaid": "^12.2.0",
    "n3": "^2.13.12",
    "ngraph.forcelayout": "^3.3.1",
    "ngraph.graph": "^20.1.2",
    "plotly.js-dist-min": "^3.7.0",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-globe.gl": "^2.38.0",
    "react-router-dom": "^7.18.3",
    "three": "^0.186.0",
    "webcola": "^3.4.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/leaflet": "^1.9.22",
    "@types/n3": "^1.26.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xmldom/xmldom": "^0.9.12",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  },
  "overrides": {
    "lodash-es": "^4.18.1",
    "nanoid": "^3.3.19",
    "sharp": "^0.35.5",
    "sass": "^1.79.0",
    "katex": "^0.18.2",
    "source-map-js": "^1.2.2",
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "^5.1.16"
    },
    "onnxruntime-node": {
      "global-agent": "^4.1.3"
    }
  }
}
